{
  "name": "@dreamlit/sdks",
  "version": "1.0.0",
  "description": "Enterprise-grade SDKs for building on Walrus and Sui blockchain",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "bun run --filter '*' build",
    "test": "bun test",
    "clean": "rm -rf packages/*/dist apps/*/dist",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "changeset": "changeset",
    "version": "changeset version && bun install --lockfile-only",
    "release": "bun run build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "globals": "^15.0.0",
    "prettier": "^3.2.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.0.0"
  },
  "keywords": [
    "walrus",
    "sui",
    "blockchain",
    "storage",
    "decentralized",
    "sdk"
  ],
  "author": "Dreamlit",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git@github.com:Vjust/dreamlit-walrus-sdk.git"
  }
}
