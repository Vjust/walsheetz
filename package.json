{
  "name": "walsheetz",
  "version": "1.0.0",
  "description": "Arctic Collaborative Spreadsheets - Navigate your data like a walrus on ice",
  "type": "module",
  "scripts": {
    "predev": "node scripts/generate-abi-types.js",
    "dev": "vite",
    "bridge": "node scripts/start-bridge-if-free.js",
    "cleanup": "node scripts/cleanup-ports.js",
    "dev:full": "bun run cleanup && bun run bridge & bun run dev",
    "test:wallet": "node scripts/test-wallet-connection.js",
    "test:slush": "node scripts/test-slush-wallet.js",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "typecheck:watch": "tsc --noEmit --watch",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:property": "vitest run tests/property",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest --watch",
    "test:docker": "docker-compose -f tests/docker-compose.test.yml up --abort-on-container-exit",
    "test:docker:build": "docker build -f Dockerfile.test -t walsheetz-test .",
    "test:docker:run": "VITEST_LOG_LEVEL=verbose LOG_TIMESTAMPS=true LOG_COLORS=true vitest run --reporter=verbose",
    "test:docker:services": "vitest run tests/unit/services --reporter=verbose",
    "test:services": "VITEST_LOG_LEVEL=verbose vitest run tests/unit/services",
    "test:services:watch": "VITEST_LOG_LEVEL=verbose vitest --watch tests/unit/services",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "E2E_HEADLESS=false playwright test",
    "test:e2e:debug": "E2E_HEADLESS=false E2E_LOG_LEVEL=debug playwright test --debug",
    "test:e2e:usability": "playwright test tests/e2e/usability",
    "test:e2e:a11y": "playwright test tests/e2e/accessibility",
    "test:e2e:chrome": "playwright test --project=chromium",
    "test:e2e:firefox": "playwright test --project=firefox",
    "test:e2e:webkit": "playwright test --project=webkit",
    "test:e2e:mobile": "playwright test --project=mobile-chrome --project=mobile-safari",
    "test:e2e:visual": "UPDATE_SNAPSHOTS=true playwright test",
    "test:e2e:report": "playwright show-report tests/e2e/reports/html",
    "test:e2e:docker": "docker-compose -f docker-compose.e2e.yml up --abort-on-container-exit --exit-code-from e2e-tests",
    "test:e2e:docker:build": "docker-compose -f docker-compose.e2e.yml build",
    "test:e2e:docker:clean": "docker-compose -f docker-compose.e2e.yml down -v",
    "test:e2e:neko": "cd tests/e2e && ./run-neko-tests.sh",
    "test:e2e:playwright-old": "cd tests/e2e && ./run-tests.sh",
    "test:vitest": "vitest run",
    "test:walrus": "node scripts/run-walrus-integration-tests.js",
    "test:walrus:verbose": "VITEST_REPORTER=verbose node scripts/run-walrus-integration-tests.js",
    "test:walrus:sdk": "node scripts/test-walrus-sdk-integration.js",
    "test:grpc:fallback": "node scripts/test-graphql-fallback.js",
    "test:wallet-reliability": "node scripts/test-wallet-reliability.js",
    "diagnose:save": "node scripts/diagnose-save-issues.js",
    "test:proxy": "node scripts/test-proxy.js",
    "ci:smoke": "npm run diagnose:save && npm run test:proxy",
    "test:typescript": "node scripts/test-typescript.js",
    "validate:config": "bun scripts/validate-config-alignment.js",
    "validate:walrus": "bun scripts/verify-walrus-endpoints.js testnet && bun scripts/verify-walrus-endpoints.js mainnet",
    "build:verify": "bun run build && bun scripts/verify-production-build.js",
    "ci:build": "bun run build:verify",
    "ci:validate": "bun run ci:build && bun run validate:config && bun run test:run"
  },
  "devDependencies": {
    "@playwright/test": "^1.47.0",
    "@rollup/rollup-darwin-arm64": "^4.50.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "buffer": "^6.0.3",
    "fast-check": "^4.2.0",
    "happy-dom": "^18.0.1",
    "jsdom": "^26.1.0",
    "pixelmatch": "^6.0.0",
    "pngjs": "^7.0.0",
    "process": "^0.11.10",
    "stream-browserify": "^3.0.0",
    "typescript": "^5.9.2",
    "util": "^0.12.5",
    "vite": "^5.0.0",
    "vite-plugin-node-polyfills": "^0.24.0",
    "vitest": "^3.2.4",
    "wait-on": "^8.0.1"
  },
  "dependencies": {
    "@mysten/dapp-kit": "^0.17.3",
    "@mysten/sui": "^1.38.0",
    "@mysten/wallet-standard": "^0.16.10",
    "@mysten/walrus": "^0.2.0",
    "@suilend/sdk": "^1.1.81",
    "@tanstack/react-query": "^5.0.0",
    "dev": "^0.1.3",
    "framer-motion": "^12.23.19",
    "lucide-react": "^0.544.0",
    "luckyexcel": "^1.0.1",
    "luckysheet": "^2.1.13",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.9.1",
    "xlsx": "^0.18.5"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "resolutions": {
    "use-sync-external-store": "^1.2.0",
    "@mysten/sui": "1.38.0"
  }
}
