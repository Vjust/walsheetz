{
  "name": "walsheetz",
  "version": "1.0.0",
  "description": "Arctic Collaborative Spreadsheets - Navigate your data like a walrus on ice",
  "type": "module",
  "scripts": {
    "predev": "node scripts/generate-abi-types.js",
    "dev": "vite --host 0.0.0.0 --port 3005 --strictPort --logLevel info --clearScreen false",
    "bridge": "node scripts/start-bridge-if-free.js",
    "cleanup": "node scripts/cleanup-ports.js",
    "dev:full": "bun run cleanup && bun run bridge & bun run dev",
    "test:wallet": "node scripts/test-wallet-connection.js",
    "test:slush": "node scripts/test-slush-wallet.js",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:property": "vitest run tests/property",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest --watch",
    "test:docker": "docker-compose -f tests/docker-compose.test.yml up --abort-on-container-exit",
    "test:e2e": "cd tests/e2e && ./run-neko-tests.sh",
    "test:e2e:neko": "cd tests/e2e && ./run-neko-tests.sh",
    "test:e2e:docker": "cd tests/e2e && docker-compose -f docker-compose-neko.yml up --abort-on-container-exit --exit-code-from e2e-tests",
    "test:e2e:playwright": "cd tests/e2e && ./run-tests.sh",
    "test:vitest": "vitest run",
    "test:walrus": "node scripts/run-walrus-integration-tests.js",
    "test:walrus:verbose": "VITEST_REPORTER=verbose node scripts/run-walrus-integration-tests.js",
    "test:wallet-reliability": "node scripts/test-wallet-reliability.js",
    "diagnose:save": "node scripts/diagnose-save-issues.js",
    "test:proxy": "node scripts/test-proxy.js",
    "ci:smoke": "npm run diagnose:save && npm run test:proxy",
    "ci:validate": "npm run test:unit && npm run ci:smoke"
  },
  "devDependencies": {
    "@playwright/test": "^1.47.0",
    "@rollup/rollup-darwin-arm64": "^4.50.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "buffer": "^6.0.3",
    "fast-check": "^4.2.0",
    "happy-dom": "^18.0.1",
    "jsdom": "^26.1.0",
    "process": "^0.11.10",
    "stream-browserify": "^3.0.0",
    "util": "^0.12.5",
    "vite": "^5.0.0",
    "vite-plugin-node-polyfills": "^0.24.0",
    "vitest": "^3.2.4",
    "wait-on": "^8.0.1"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.13.4",
    "@grpc/proto-loader": "^0.8.0",
    "@mysten/dapp-kit": "^0.17.3",
    "@mysten/sui": "^1.0.0",
    "@mysten/wallet-standard": "^0.16.10",
    "@tanstack/react-query": "^5.0.0",
    "dev": "^0.1.3",
    "google-protobuf": "^4.0.0",
    "luckysheet": "^2.1.13",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "ws": "^8.18.3"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "resolutions": {
    "use-sync-external-store": "^1.2.0"
  }
}
