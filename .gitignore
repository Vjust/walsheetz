# Dependencies
node_modules/
**/node_modules/
.pnp
.pnp.js

# Build outputs
dist/
**/dist/
build/
**/build/
*.tsbuildinfo

# Package build artifacts
packages/*/dist/
packages/*/build/
apps/*/dist/
apps/*/build/

# Test coverage
coverage/
**/coverage/
.nyc_output/

# Environment files
.env
.env.local
.env.*.local

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Temporary files
*.tmp
*.temp
.cache/

# Move build artifacts (keep source only)
*/move/**/build/
*/move/**/locks/

# Personal/local config
.claude/
*.db
*.sqlite

# Tool caches
.eslintcache
.prettiercache

# Changesets
.changeset/**/*.md
!.changeset/README.md
!.changeset/config.json

# Generated reference docs (not source docs)
reference/
**/reference/

