# WalSheetz Environment Configuration

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================

# Frontend Log Level (browser console)
# Values: DEBUG, INFO, WARN, ERROR, CRITICAL
# Default: WARN in dev, ERROR in production
VITE_LOG_LEVEL=WARN

# Component-Specific Debug Logging (frontend)
# Comma-separated list of components to enable debug logs for
# Components: SpreadsheetEngine, BlockchainAdapter, WebSocketService, UIComponent,
#             WalletManager, StorageService, Collaboration, Performance
# Example: VITE_DEBUG_COMPONENTS=BLOCKCHAIN_ADAPTER,STORAGE_SERVICE
VITE_DEBUG_COMPONENTS=

# Backend Log Level (Node/Bun scripts)
# Values: DEBUG, INFO, WARN, ERROR, CRITICAL
# Default: INFO
LOG_LEVEL=INFO

# Verbose Vite Proxy Logging
# Set to true for detailed proxy request/response logs
# Default: false
VITE_VERBOSE_PROXY=false

# =============================================================================
# WALRUS SERVICE CONFIGURATION
# =============================================================================

# Walrus Service Configuration
# Set to 'true' to use absolute endpoints even in development
# Useful for environments without proxy support
WALRUS_USE_ABSOLUTE=false

# Rate Limiting Configuration
RATE_LIMITER_ENABLED=true
SUI_MAX_RPS=3
SUI_BURST=6
SUI_MAX_CONCURRENT=4
WALRUS_AGG_MAX_RPS=3
WALRUS_AGG_BURST=3
WALRUS_AGG_MAX_CONCURRENT=2
WALRUS_PUB_MAX_RPS=1
WALRUS_PUB_BURST=1
WALRUS_PUB_MAX_CONCURRENT=1

# Storage Configuration
WALRUS_COMPRESSION=true
COMPRESSION_THRESHOLD=16384
ENABLE_DELTA=true
DELTA_MAX_CHAIN=5
BATCH_PERSISTENCE=true

# WebSocket Bridge Configuration
BRIDGE_PORT=8081
BRIDGE_HOST=localhost
BRIDGE_MAX_CLIENTS=100
BRIDGE_LOG_LEVEL=INFO
ENABLE_METRICS=false

# UI Configuration
SHOW_RATE_LIMITER_STATUS=false

# =============================================================================
# NOTES
# =============================================================================
# - Query parameters can override frontend log settings temporarily:
#   Example: http://localhost:3005?debug=BLOCKCHAIN_ADAPTER
#   Example: http://localhost:3005?debug=true (enable all debug)
#
# - Browser console helpers:
#   window.walSheetzLogConfig.getConfig() - View current log config
#   window.walSheetzLogger.getMetrics() - View logger metrics
#
# - For more logging details, see: docs/debug-logging.md
# - For network configuration, see: docs/CONFIGURATION.md