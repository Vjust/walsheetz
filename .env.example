# WalSheetz Environment Configuration

# Walrus Service Configuration
# Set to 'true' to use absolute endpoints even in development
# Useful for environments without proxy support
WALRUS_USE_ABSOLUTE=false

# Rate Limiting Configuration
RATE_LIMITER_ENABLED=true
SUI_MAX_RPS=3
SUI_BURST=6
SUI_MAX_CONCURRENT=4
WALRUS_AGG_MAX_RPS=3
WALRUS_AGG_BURST=3
WALRUS_AGG_MAX_CONCURRENT=2
WALRUS_PUB_MAX_RPS=1
WALRUS_PUB_BURST=1
WALRUS_PUB_MAX_CONCURRENT=1

# Storage Configuration
WALRUS_COMPRESSION=true
COMPRESSION_THRESHOLD=16384
ENABLE_DELTA=true
DELTA_MAX_CHAIN=5
BATCH_PERSISTENCE=true

# WebSocket Bridge Configuration
BRIDGE_PORT=8081
BRIDGE_HOST=localhost
BRIDGE_MAX_CLIENTS=100
BRIDGE_LOG_LEVEL=INFO
ENABLE_METRICS=false

# UI Configuration
SHOW_RATE_LIMITER_STATUS=false