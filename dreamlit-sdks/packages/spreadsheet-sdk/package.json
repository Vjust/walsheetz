{
  "name": "@dreamlit/spreadsheet-sdk",
  "version": "1.0.0",
  "description": "React SDK for building Walrus-powered spreadsheet applications",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./components": "./dist/components/index.js",
    "./hooks": "./dist/business/index.js",
    "./services": "./dist/services/index.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "peerDependencies": {
    "@dreamlit/walrus": "^1.0.0",
    "@dreamlit/walrus-sui-core": "^1.0.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "dependencies": {
    "@mysten/dapp-kit": "^0.17.3",
    "@mysten/sui": "^1.38.0",
    "@tanstack/react-query": "^5.0.0",
    "luckysheet": "^2.1.13",
    "luckyexcel": "^1.0.1",
    "xlsx": "^0.18.5",
    "framer-motion": "^12.23.19",
    "lucide-react": "^0.544.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "tsup": "^8.3.5",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  },
  "keywords": [
    "walrus",
    "sui",
    "spreadsheet",
    "react",
    "blockchain",
    "storage"
  ],
  "author": "Dreamlit",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git@github.com:Vjust/dreamlit-walrus-sdk.git"
  }
}
