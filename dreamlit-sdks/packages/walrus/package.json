{
  "name": "@dreamlit/walrus",
  "version": "1.0.0",
  "description": "Walrus decentralized storage adapter for browser and Node.js",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/index.js",
      "node": "./dist/node.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "walrus",
    "storage",
    "decentralized",
    "sui",
    "blockchain"
  ],
  "author": "Dreamlit",
  "license": "MIT",
  "dependencies": {
    "@mysten/walrus": "^0.2.0",
    "@mysten/sui": "^1.38.0"
  },
  "optionalDependencies": {
    "undici": "^6.0.0"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "tsup": "^8.0.0",
    "vitest": "^2.0.0"
  }
}
