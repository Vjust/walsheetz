{
  "buildCommand": "bun run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/app-config.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "max-age=60, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/app-config.json",
      "destination": "/app-config.json"
    },
    {
      "source": "/api/walrus-publisher-mainnet/:path*",
      "destination": "/api/walrus-publisher-mainnet"
    },
    {
      "source": "/api/walrus-aggregator-mainnet/:path*",
      "destination": "/api/walrus-aggregator-mainnet"
    },
    {
      "source": "/api/walrus-publisher-testnet/:path*",
      "destination": "/api/walrus-publisher-testnet"
    },
    {
      "source": "/api/walrus-aggregator-testnet/:path*",
      "destination": "/api/walrus-aggregator-testnet"
    },
    {
      "source": "/:path((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
