{
  "buildCommand": "bun run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "routes": [
    { "src": "/api/walrus-publisher-mainnet(.*)", "dest": "/api/walrus-publisher-mainnet" },
    { "src": "/api/walrus-aggregator-mainnet(.*)", "dest": "/api/walrus-aggregator-mainnet" },
    { "src": "/api/walrus-publisher-testnet(.*)", "dest": "/api/walrus-publisher-testnet" },
    { "src": "/api/walrus-aggregator-testnet(.*)", "dest": "/api/walrus-aggregator-testnet" }
  ],
  "headers": [
    {
      "source": "/app-config.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "max-age=60, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/app-config.json",
      "destination": "/app-config.json"
    },
    {
      "source": "/((?!api).*)",
      "destination": "/index.html"
    }
  ]
}
